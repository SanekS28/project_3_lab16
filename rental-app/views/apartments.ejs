<%- include('partials/header') %>

<h1>Квартири в оренду</h1>

<a href="/apartments/create" style="display:inline-block; margin-bottom: 20px;">
    <button>Додати квартиру</button>
</a>

<% if (message) { %>
    <div style="color: green;"><%= message %></div>
<% } %>
<% if (error) { %>
    <div style="color: red;"><%= error %></div>
<% } %>

<ul>
    <% apartments.forEach(ap => { %>
        <li>
            <strong><%= ap.description %></strong><br>
            Власник: <%= ap.owner %><br>
            Ціна: <%= ap.price %> грн<br>
            Кількість кімнат: <%= ap.rooms %><br>
            Площа: <%= ap.size %> м²<br>
            Район: <%= ap.location %><br><br>

            <form action="/apartments/delete/<%= ap.id %>" method="POST" style="display:inline;">
                <button type="submit">Видалити</button>
            </form>

            <form action="/apartments/duplicate/<%= ap.id %>" method="POST" style="display:inline;">
                <button type="submit">Копіювати</button>
            </form>

            <a href="/apartments/edit/<%= ap.id %>">Редагувати</a>
        </li>
        <hr>
    <% }); %>
</ul>

<%- include('partials/footer') %>
